# ============================================================================
#  PROJECT J.A.R.V.I.S. -- environment template
#  Copy to `.env` (same folder as this file) and fill in your secrets.
#  .env is git-ignored; nothing here is ever committed.
# ============================================================================

# ------------------------------------------------------------- AI providers (Track 2)
# JARVIS rotates between free-tier providers. Add ONE key to get started; add more
# and JARVIS will fail over to the next one automatically whenever a quota runs out
# (a 429 takes that provider out of rotation for the length of ITS window - a minute
# for an RPM throttle, until the daily reset for a daily quota, max LLM_COOLDOWN_HOURS).
#
#   provider      free tier (as of 2026-09)                              where to get a key
#   -----------   ---------------------------------------------------     --------------------------------
#   groq          30 req/min; 14,400/day (8B), 1,000/day (70B)           https://console.groq.com/keys
#   cerebras      ~1M tokens/day, 30 req/min (8K context on free)        https://cloud.cerebras.ai
#   cloudflare    10,000 Neurons/day (needs account id too)              https://dash.cloudflare.com
#   gemini        ~1,000 req/day on Flash-Lite, 15 req/min                https://aistudio.google.com/apikey
#   mistral       'Experiment' tier, ~1B tokens/month (may train on you)  https://console.mistral.ai/api-keys
#   openrouter    50 req/day on ':free' models                            https://openrouter.ai/settings/keys
#   github        150-1,000 req/day incl. gpt-4o; PAT needs models:read    https://github.com/settings/tokens
#
# Recommended: GROQ (fastest, ~500 ms first token) + CEREBRAS as backup.
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# Cloudflare needs both: the token AND the account id shown in the dashboard URL.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# A dedicated GitHub PAT (models:read). Do NOT paste your gh/CI token here.
GITHUB_MODELS_TOKEN=

# Any OTHER OpenAI-compatible endpoint - tried before the vendors above when set, so you
# are not limited to my shortlist. Works with NVIDIA NIM (https://integrate.api.nvidia.com/v1,
# ~1,000 free credits/day, nvidia/llama-3.3-70b-instruct), SambaNova, Fireworks, an Azure
# deployment, or a LOCAL Ollama (http://127.0.0.1:11434/v1) / LM Studio for a no-internet demo.
CUSTOM_LLM_BASE_URL=
# Leave the key empty for local servers: no auth header is then sent.
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_NAME=Custom endpoint
CUSTOM_LLM_MODEL_FAST=meta/llama-3.1-8b-instruct
# SMART defaults to FAST when unset.
CUSTOM_LLM_MODEL_SMART=nvidia/llama-3.3-70b-instruct
# false = never send native tool calls to it (the agent asks for JSON in the prompt
# instead), which is what most local runtimes need.
CUSTOM_LLM_TOOLS=true
# How its quota resets, for the cooldown maths: daily-utc | daily-pacific | none
CUSTOM_LLM_RESET=none
#CUSTOM_LLM_QUOTA=1000 credits/day

# Rotation order; unknown names are ignored, missing keys are skipped.
LLM_PROVIDER_ORDER=groq,cerebras,cloudflare,gemini,mistral,openrouter,github
# Force one provider (skip the rest). "auto" = use the order above.
LLM_PROVIDER=auto
# Wall-clock ceiling for one AI turn across ALL providers. Better a heuristic answer
# in 25s than a frozen mic while seven endpoints time out.
LLM_BUDGET_SECONDS=25
LLM_TIMEOUT_SECONDS=30
LLM_PROBE_TIMEOUT_SECONDS=12
# After a 429/auth failure, how long to leave a provider alone (the ceiling; a
# Retry-After header or a per-minute throttle shortens it automatically).
LLM_COOLDOWN_HOURS=24
# When two providers fail on the network (no egress / DNS / captive portal), rest
# the whole pool this long instead of re-probing on every utterance.
LLM_OFFLINE_COOLDOWN_SECONDS=180
# auto = cheap model for chat/tool calls, big model for reasoning-heavy asks.
# Force with fast|smart. Override the model ids per provider with <KEY>_MODEL_FAST/SMART.
LLM_TIER_MODE=auto
# GROQ_MODEL_FAST=llama-3.1-8b-instant
# GROQ_MODEL_SMART=llama-3.3-70b-versatile
# CEREBRAS_MODEL_SMART=gpt-oss-120b
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0.2
# If no provider can answer, may the offline planner use DuckDuckGo for questions
# that genuinely need live data (news, scores, prices)? "what is X" style questions
# are left to the model and are never searched.
LLM_FALLBACK_SEARCH=true
# Where cooldowns survive a restart.
LLM_STATE_FILE=data/llm_state.json

# ------------------------------------------------------------- Latency routing
# Track 1 = regex instant execution (no LLM). Track 2 = agentic provider call.
INSTANT_TRACK_ENABLED=true
# A prompt shorter than this and matching no regex goes straight to the agent.
AGENT_MIN_CHARS=3

# ---------------------------------------------------------------- Voice: STT
# tiny | base | small | medium  (tiny/base fit a 4GB RTX 3050 comfortably)
WHISPER_MODEL=base
WHISPER_DEVICE=cuda
# int8 keeps fp16 weights + activations under ~1.1 GB VRAM.
WHISPER_COMPUTE_TYPE=int8
WHISPER_NUM_WORKERS=2
WHISPER_CPU_THREADS=4
WHISPER_BEAM_SIZE=1
WHISPER_LANGUAGE=
WHISPER_VAD_FILTER=true
# Auto-fall back to cpu/int8 (then cpu/float32) when CUDA init fails.
WHISPER_ALLOW_CPU_FALLBACK=true

# ---------------------------------------------------------------- Voice: TTS
# XTTS-v2 zero-shot clone. Reference must be 3-10 s of clean JARVIS speech.
TTS_ENABLED=true
TTS_LANGUAGE=en
TTS_SPEED=1.02
TTS_DEVICE=cuda
# Set false on a 4GB card if you also load Whisper on GPU.
TTS_LOW_VRAM=true
# Path to the reference clip used for voice cloning.
TTS_REFERENCE_WAV=assets/jarvis_sample.wav
# Optional local Coqui model dir (skips any download when set).
TTS_MODEL_DIR=
TTS_SAMPLE_RATE=24000

# ---------------------------------------------------------------- Discord
# Bot token: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# Numeric channel id JARVIS listens to ("Copy Message Link" / devtools).
DISCORD_CHANNEL_ID=
DISCORD_COMMAND_PREFIX=/jarvis
# Reply as a thread when the answer is long.
DISCORD_USE_THREADS=true
DISCORD_ENABLED=true

# ---------------------------------------------------------------- Sports API
# Free tier key: https://dashboard.api-football.com/
API_SPORTS_KEY=
API_SPORTS_BASE=https://v3.football.api-sports.io
API_SPORTS_TIMEOUT=12
# Default team used when the user just says "football scores".
API_SPORTS_DEFAULT_TEAM=Real Madrid

# ---------------------------------------------------------------- OS tools
# Directory scanned by read_notes()
NOTES_DIR=notes
# Seconds a launched process may hang before launch_app() reports success.
LAUNCH_TIMEOUT=6
# Extra apps: NAME=C:\path\to\app.exe  (semicolon separated list)
CUSTOM_APPS=Eden=D:\Emulators\Eden\eden.exe
# Play/Stop etc. on standard Windows volume mixer (1-100).
VOLUME_STEP=8

# ---------------------------------------------------------------- Server / HUD
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8760
JARVIS_WS_TELEMETRY_MS=800
JARVIS_CORS_ALLOW_ORIGINS=*
# History buffer kept in RAM for the agent context window.
JARVIS_HISTORY_SIZE=12
# Auto-speak every assistant reply through XTTS (false = text only)
SPEAK_REPLIES=true
# Play audio out of the default device after synthesis.
TTS_PLAYBACK=true
JARVIS_DEBUG=true
